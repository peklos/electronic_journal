<Window x:Class="ElectronicJournal.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Электронный журнал БППК - Вход"
        Height="650"
        Width="500"
        MinHeight="600"
        MinWidth="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundColor}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryColor}"
                Padding="20">
            <StackPanel>
                <TextBlock Text="Электронный журнал"
                          FontSize="24"
                          FontWeight="Bold"
                          Foreground="{StaticResource TextColor}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="БППК - Система управления классом"
                          FontSize="12"
                          Foreground="{StaticResource LightTextColor}"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Форма входа -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceColor}"
                Margin="20"
                CornerRadius="10"
                Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                Color="#000000"
                                Opacity="0.5"
                                ShadowDepth="0"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">
                <TextBlock Text="Вход в систему"
                          FontSize="20"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource TextColor}"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,30"/>

                <TextBlock Text="Имя пользователя"
                          FontSize="13"
                          Foreground="{StaticResource TextColor}"
                          Margin="5,0,0,5"/>
                <TextBox x:Name="UsernameTextBox"
                        Style="{StaticResource ModernTextBox}"/>

                <TextBlock Text="Пароль"
                          FontSize="13"
                          Foreground="{StaticResource TextColor}"
                          Margin="5,15,0,5"/>
                <PasswordBox x:Name="PasswordBox"
                            Style="{StaticResource ModernPasswordBox}"/>

                <TextBlock x:Name="ErrorTextBlock"
                          Text=""
                          FontSize="12"
                          Foreground="{StaticResource AccentColor}"
                          HorizontalAlignment="Center"
                          Margin="0,10,0,0"
                          TextWrapping="Wrap"/>

                <Button Content="Войти"
                        Style="{StaticResource ModernButton}"
                        Margin="0,20,0,0"
                        Click="LoginButton_Click"/>

                <Separator Margin="0,20,0,20" Background="{StaticResource BorderColor}"/>

                <TextBlock HorizontalAlignment="Center">
                    <Run Text="Нет аккаунта?"
                         FontSize="13"
                         Foreground="{StaticResource LightTextColor}"/>
                    <Hyperlink Click="RegisterLink_Click"
                              Foreground="{StaticResource SecondaryColor}">
                        <Run Text="Зарегистрироваться"
                             FontSize="13"/>
                    </Hyperlink>
                </TextBlock>

                <Border Background="#1B5E20"
                        BorderBrush="{StaticResource SuccessColor}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Тестовый доступ (Куратор):"
                                  FontSize="12"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource SuccessColor}"/>
                        <TextBlock Text="Логин: admin"
                                  FontSize="11"
                                  Foreground="{StaticResource TextColor}"
                                  Margin="0,5,0,0"/>
                        <TextBlock Text="Пароль: admin"
                                  FontSize="11"
                                  Foreground="{StaticResource TextColor}"/>
                    </StackPanel>
                </Border>

                <Border Background="#0D47A1"
                        BorderBrush="{StaticResource SecondaryColor}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Тестовый доступ (Студент):"
                                  FontSize="12"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource SecondaryColor}"/>
                        <TextBlock Text="Логин: ivanov"
                                  FontSize="11"
                                  Foreground="{StaticResource TextColor}"
                                  Margin="0,5,0,0"/>
                        <TextBlock Text="Пароль: ivanov"
                                  FontSize="11"
                                  Foreground="{StaticResource TextColor}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
