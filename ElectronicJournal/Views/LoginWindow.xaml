<Window x:Class="ElectronicJournal.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АИС Колледж - Авторизация"
        Height="600"
        Width="900"
        MinHeight="550"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundColor}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель с информацией -->
        <Border Grid.Column="0"
                Background="{StaticResource PrimaryColor}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="40">

                    <!-- Логотип/Иконка -->
                    <Border Background="#FFFFFF"
                            Width="100"
                            Height="100"
                            CornerRadius="50"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,30">
                        <TextBlock Text="АИС"
                                  FontSize="32"
                                  FontWeight="Bold"
                                  Foreground="{StaticResource PrimaryColor}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Автоматизированная"
                              FontSize="28"
                              FontWeight="Light"
                              Foreground="#FFFFFF"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Информационная Система"
                              FontSize="28"
                              FontWeight="Bold"
                              Foreground="#FFFFFF"
                              HorizontalAlignment="Center"/>

                    <TextBlock Text="КОЛЛЕДЖ"
                              FontSize="42"
                              FontWeight="Bold"
                              Foreground="#FFFFFF"
                              HorizontalAlignment="Center"
                              Margin="0,20,0,0"/>

                    <Border Background="#3949AB"
                            CornerRadius="8"
                            Padding="20,15"
                            Margin="0,40,0,0"
                            MaxWidth="350">
                        <StackPanel>
                            <TextBlock Text="Система управления данными студентов"
                                      FontSize="14"
                                      Foreground="#E8EAF6"
                                      TextWrapping="Wrap"
                                      TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="1"
                          Text="v2.0  2024-2025 учебный год"
                          FontSize="12"
                          Foreground="#9FA8DA"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,20"/>
            </Grid>
        </Border>

        <!-- Правая панель - форма входа -->
        <Border Grid.Column="1"
                Background="{StaticResource SurfaceColor}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <StackPanel VerticalAlignment="Center"
                           Margin="40">

                    <TextBlock Text="Вход в систему"
                              FontSize="26"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextColor}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,10"/>

                    <TextBlock Text="Введите учетные данные для доступа"
                              FontSize="13"
                              Foreground="{StaticResource LightTextColor}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,40"/>

                    <TextBlock Text="Имя пользователя"
                              Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UsernameTextBox"
                            Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Text="Пароль"
                              Style="{StaticResource FieldLabel}"
                              Margin="0,15,0,4"/>
                    <PasswordBox x:Name="PasswordBox"
                                Style="{StaticResource ModernPasswordBox}"/>

                    <TextBlock x:Name="ErrorTextBlock"
                              Text=""
                              FontSize="13"
                              Foreground="{StaticResource AccentColor}"
                              HorizontalAlignment="Center"
                              Margin="0,15,0,0"
                              TextWrapping="Wrap"/>

                    <Button Content="Войти в систему"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,25,0,0"
                            Padding="30,14"
                            FontSize="15"
                            HorizontalAlignment="Stretch"
                            Click="LoginButton_Click"/>

                    <Separator Margin="0,30,0,30" Background="{StaticResource BorderColor}"/>

                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Run Text="Нет учетной записи?"
                             FontSize="13"
                             Foreground="{StaticResource LightTextColor}"/>
                        <Hyperlink Click="RegisterLink_Click"
                                  Foreground="{StaticResource SecondaryColor}">
                            <Run Text="Зарегистрироваться"
                                 FontSize="13"
                                 FontWeight="SemiBold"/>
                        </Hyperlink>
                    </TextBlock>

                    <!-- Тестовые данные -->
                    <Border Background="#E8F5E9"
                            BorderBrush="{StaticResource SuccessColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Тестовый доступ (Преподаватель):"
                                      FontSize="12"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource SuccessColor}"/>
                            <TextBlock FontSize="12"
                                      Foreground="{StaticResource TextSecondaryColor}"
                                      Margin="0,5,0,0">
                                <Run Text="Логин:"/> <Run Text="admin" FontWeight="SemiBold"/>
                                <Run Text="  |  Пароль:"/> <Run Text="admin" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Background="#E3F2FD"
                            BorderBrush="{StaticResource SecondaryColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Тестовый доступ (Студент):"
                                      FontSize="12"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource SecondaryColor}"/>
                            <TextBlock FontSize="12"
                                      Foreground="{StaticResource TextSecondaryColor}"
                                      Margin="0,5,0,0">
                                <Run Text="Логин:"/> <Run Text="ivanov" FontWeight="SemiBold"/>
                                <Run Text="  |  Пароль:"/> <Run Text="ivanov" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
