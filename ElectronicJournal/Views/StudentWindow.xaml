<Window x:Class="ElectronicJournal.Views.StudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Электронный журнал - Панель ученика"
        Height="700"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BackgroundColor}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryColor}"
                Padding="20">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text=""
                              FontSize="28"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock x:Name="WelcomeTextBlock"
                                  FontSize="20"
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextColor}"/>
                        <TextBlock Text="Личный кабинет ученика"
                                  FontSize="12"
                                  Foreground="#BDC3C7"/>
                    </StackPanel>
                </StackPanel>

                <Button Content="Выход"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource AccentColor}"
                        HorizontalAlignment="Right"
                        Click="LogoutButton_Click"/>
            </Grid>
        </Border>

        <!-- Главный контент с вкладками -->
        <TabControl Grid.Row="1"
                   Margin="20"
                   Background="{StaticResource SurfaceColor}"
                   BorderThickness="0">
            <!-- Вкладка: Личная информация -->
            <TabItem Header="Личная информация" FontSize="14" Padding="15,10">
                <Border Margin="30" Background="{StaticResource SurfaceColor}">
                    <StackPanel MaxWidth="600">
                        <TextBlock Text="📋 Моя информация"
                                  FontSize="24"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextColor}"
                                  Margin="0,0,0,30"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                      Text="ФИО:"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextColor}"
                                      Margin="0,10,0,10"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                      x:Name="FullNameTextBlock"
                                      FontSize="14"
                                      Foreground="{StaticResource TextColor}"
                                      Margin="0,10,0,10"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                      Text="Группа:"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextColor}"
                                      Margin="0,10,0,10"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                      x:Name="GroupTextBlock"
                                      FontSize="14"
                                      Foreground="{StaticResource TextColor}"
                                      Margin="0,10,0,10"/>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                      Text="Дата рождения:"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextColor}"
                                      Margin="0,10,0,10"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                      x:Name="BirthDateTextBlock"
                                      FontSize="14"
                                      Foreground="{StaticResource TextColor}"
                                      Margin="0,10,0,10"/>

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                      Text="Телефон родителя:"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextColor}"
                                      Margin="0,10,0,10"/>
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                      x:Name="ParentPhoneTextBlock"
                                      FontSize="14"
                                      Foreground="{StaticResource TextColor}"
                                      Margin="0,10,0,10"/>

                            <TextBlock Grid.Row="4" Grid.Column="0"
                                      Text="Адрес:"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextColor}"
                                      Margin="0,10,0,10"/>
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                      x:Name="AddressTextBlock"
                                      FontSize="14"
                                      Foreground="{StaticResource TextColor}"
                                      Margin="0,10,0,10"
                                      TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="5" Grid.Column="0"
                                      Text="Примечания:"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextColor}"
                                      Margin="0,10,0,10"
                                      VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="5" Grid.Column="1"
                                      x:Name="NotesTextBlock"
                                      FontSize="14"
                                      Foreground="{StaticResource TextColor}"
                                      Margin="0,10,0,10"
                                      TextWrapping="Wrap"/>
                        </Grid>

                        <!-- Статистика -->
                        <Border Background="#1B3A1B"
                                BorderBrush="{StaticResource SuccessColor}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="20"
                                Margin="0,30,0,0">
                            <StackPanel>
                                <TextBlock Text="Моя статистика"
                                          FontSize="18"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource SuccessColor}"
                                          Margin="0,0,0,15"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Средний балл:"
                                                  FontSize="14"
                                                  Foreground="{StaticResource TextColor}"/>
                                        <TextBlock x:Name="AverageGradeTextBlock"
                                                  FontSize="32"
                                                  FontWeight="Bold"
                                                  Foreground="#66BB6A"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Всего оценок:"
                                                  FontSize="14"
                                                  Foreground="{StaticResource TextColor}"/>
                                        <TextBlock x:Name="TotalGradesTextBlock"
                                                  FontSize="32"
                                                  FontWeight="Bold"
                                                  Foreground="#64B5F6"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Вкладка: Мои оценки -->
            <TabItem Header="📚 Мои оценки" FontSize="14" Padding="15,10">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="Обновить"
                                Style="{StaticResource ModernButton}"
                                Click="RefreshGradesButton_Click"/>
                        <TextBlock x:Name="GradesInfoTextBlock"
                                  FontSize="14"
                                  Foreground="{StaticResource LightTextColor}"
                                  VerticalAlignment="Center"
                                  Margin="20,0,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="GradesDataGrid"
                             Grid.Row="1"
                             Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="*"/>
                            <DataGridTextColumn Header="Оценка" Binding="{Binding GradeValue}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GradeValue}" Value="5">
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GradeValue}" Value="4">
                                                <Setter Property="Foreground" Value="#3498DB"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GradeValue}" Value="3">
                                                <Setter Property="Foreground" Value="#F39C12"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GradeValue}" Value="2">
                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="120"/>
                            <DataGridTextColumn Header="Тема урока" Binding="{Binding Topic}" Width="*"/>
                            <DataGridTextColumn Header="Примечание" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка: Моя посещаемость -->
            <TabItem Header="Моя посещаемость" FontSize="14" Padding="15,10">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="Обновить"
                                Style="{StaticResource ModernButton}"
                                Click="RefreshAttendanceButton_Click"/>
                        <TextBlock x:Name="AttendanceInfoTextBlock"
                                  FontSize="14"
                                  Foreground="{StaticResource LightTextColor}"
                                  VerticalAlignment="Center"
                                  Margin="20,0,0,0"/>
                    </StackPanel>

                    <DataGrid x:Name="AttendanceDataGrid"
                             Grid.Row="1"
                             Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="150"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="250">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Присутствовал">
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Отсутствовал">
                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="По уважительной причине">
                                                <Setter Property="Foreground" Value="#F39C12"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
