<Window x:Class="ElectronicJournal.Views.StudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АИС Колледж - Личный кабинет студента"
        Height="750"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BackgroundColor}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryColor}"
                Padding="25,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип и название -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="#FFFFFF"
                            Width="45"
                            Height="45"
                            CornerRadius="8"
                            VerticalAlignment="Center"
                            Margin="0,0,15,0">
                        <TextBlock Text="АИС"
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Foreground="{StaticResource PrimaryColor}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="АИС Колледж"
                                  FontSize="20"
                                  FontWeight="Bold"
                                  Foreground="#FFFFFF"/>
                        <TextBlock Text="Личный кабинет студента"
                                  FontSize="12"
                                  Foreground="#B0BEC5"/>
                    </StackPanel>
                </StackPanel>

                <!-- Информация о пользователе -->
                <StackPanel Grid.Column="1"
                           Orientation="Horizontal"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock x:Name="WelcomeTextBlock"
                              FontSize="15"
                              Foreground="#FFFFFF"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Кнопка выхода -->
                <Button Grid.Column="2"
                        Content="Выйти из системы"
                        Style="{StaticResource DangerButton}"
                        Padding="20,10"
                        Click="LogoutButton_Click"/>
            </Grid>
        </Border>

        <!-- Главный контент с вкладками -->
        <Border Grid.Row="1" Margin="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.08" ShadowDepth="3"/>
            </Border.Effect>
            <TabControl Background="{StaticResource SurfaceColor}">

                <!-- Вкладка: Личная информация -->
                <TabItem Header="Личная карточка" FontSize="15" Padding="25,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Margin="30" Background="{StaticResource SurfaceColor}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="350"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" MaxWidth="600">
                                    <TextBlock Text="Моя личная карточка"
                                              FontSize="24"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource TextColor}"
                                              Margin="0,0,0,25"/>

                                    <!-- Основная информация -->
                                    <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ"
                                              Style="{StaticResource SectionHeader}"/>

                                    <Border Background="#FAFAFA" CornerRadius="8" Padding="20" Margin="0,5,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО:" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FullNameTextBlock" Style="{StaticResource FieldLabel}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Группа:" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="GroupTextBlock" Style="{StaticResource FieldLabel}"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата рождения:" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BirthDateTextBlock" Style="{StaticResource FieldLabel}"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Телефон:" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PhoneTextBlock" Style="{StaticResource FieldLabel}"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Адрес:" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="AddressTextBlock" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>

                                    <!-- Данные матери -->
                                    <TextBlock Text="ДАННЫЕ МАТЕРИ"
                                              Style="{StaticResource SectionHeader}"/>

                                    <Border Background="#FFF3E0" CornerRadius="8" Padding="20" Margin="0,5,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО:" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MotherNameTextBlock" Style="{StaticResource FieldLabel}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Телефон:" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MotherPhoneTextBlock" Style="{StaticResource FieldLabel}"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Место работы:" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MotherWorkplaceTextBlock" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>

                                    <!-- Данные отца -->
                                    <TextBlock Text="ДАННЫЕ ОТЦА"
                                              Style="{StaticResource SectionHeader}"/>

                                    <Border Background="#E3F2FD" CornerRadius="8" Padding="20" Margin="0,5,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО:" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FatherNameTextBlock" Style="{StaticResource FieldLabel}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Телефон:" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FatherPhoneTextBlock" Style="{StaticResource FieldLabel}"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Место работы:" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FatherWorkplaceTextBlock" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>

                                    <!-- Дополнительно -->
                                    <TextBlock Text="ПРИМЕЧАНИЯ"
                                              Style="{StaticResource SectionHeader}"/>

                                    <Border Background="#FAFAFA" CornerRadius="8" Padding="20" Margin="0,5,0,0">
                                        <TextBlock x:Name="NotesTextBlock"
                                                  FontSize="13"
                                                  Foreground="{StaticResource TextSecondaryColor}"
                                                  TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <!-- Статистика -->
                                <StackPanel Grid.Column="1" Margin="30,0,0,0">
                                    <TextBlock Text="Моя статистика"
                                              FontSize="20"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource TextColor}"
                                              Margin="0,0,0,20"/>

                                    <Border Background="#E8F5E9"
                                            BorderBrush="{StaticResource SuccessColor}"
                                            BorderThickness="2"
                                            CornerRadius="10"
                                            Padding="25"
                                            Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="Средний балл"
                                                      FontSize="14"
                                                      Foreground="{StaticResource TextSecondaryColor}"/>
                                            <TextBlock x:Name="AverageGradeTextBlock"
                                                      FontSize="48"
                                                      FontWeight="Bold"
                                                      Foreground="{StaticResource SuccessColor}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#E3F2FD"
                                            BorderBrush="{StaticResource SecondaryColor}"
                                            BorderThickness="2"
                                            CornerRadius="10"
                                            Padding="25">
                                        <StackPanel>
                                            <TextBlock Text="Всего оценок"
                                                      FontSize="14"
                                                      Foreground="{StaticResource TextSecondaryColor}"/>
                                            <TextBlock x:Name="TotalGradesTextBlock"
                                                      FontSize="48"
                                                      FontWeight="Bold"
                                                      Foreground="{StaticResource SecondaryColor}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <!-- Вкладка: Мои оценки -->
                <TabItem Header="Мои оценки" FontSize="15" Padding="25,12">
                    <Grid Margin="25">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#FAFAFA"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Обновить список"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="RefreshGradesButton_Click"/>
                                <TextBlock x:Name="GradesInfoTextBlock"
                                          FontSize="14"
                                          Foreground="{StaticResource LightTextColor}"
                                          VerticalAlignment="Center"
                                          Margin="20,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="GradesDataGrid"
                                 Grid.Row="1"
                                 Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="*"/>
                                <DataGridTextColumn Header="Оценка" Binding="{Binding GradeValue}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="16"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GradeValue}" Value="5">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GradeValue}" Value="4">
                                                    <Setter Property="Foreground" Value="#1565C0"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GradeValue}" Value="3">
                                                    <Setter Property="Foreground" Value="#F57C00"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GradeValue}" Value="2">
                                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="120"/>
                                <DataGridTextColumn Header="Тема занятия" Binding="{Binding Topic}" Width="*"/>
                                <DataGridTextColumn Header="Примечание" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Вкладка: Моя посещаемость -->
                <TabItem Header="Моя посещаемость" FontSize="15" Padding="25,12">
                    <Grid Margin="25">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#FAFAFA"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Обновить список"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="RefreshAttendanceButton_Click"/>
                                <TextBlock x:Name="AttendanceInfoTextBlock"
                                          FontSize="14"
                                          Foreground="{StaticResource LightTextColor}"
                                          VerticalAlignment="Center"
                                          Margin="20,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="AttendanceDataGrid"
                                 Grid.Row="1"
                                 Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="150"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="250">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Присутствовал">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Отсутствовал">
                                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="По уважительной причине">
                                                    <Setter Property="Foreground" Value="#F57C00"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
