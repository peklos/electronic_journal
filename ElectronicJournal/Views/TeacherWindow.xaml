<Window x:Class="ElectronicJournal.Views.TeacherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Электронный журнал - Панель учителя"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BackgroundColor}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryColor}"
                Padding="20">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="👨‍🏫"
                              FontSize="28"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock x:Name="WelcomeTextBlock"
                                  FontSize="20"
                                  FontWeight="Bold"
                                  Foreground="White"/>
                        <TextBlock Text="Панель управления классного руководителя"
                                  FontSize="12"
                                  Foreground="#BDC3C7"/>
                    </StackPanel>
                </StackPanel>

                <Button Content="Выход"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource AccentColor}"
                        HorizontalAlignment="Right"
                        Click="LogoutButton_Click"/>
            </Grid>
        </Border>

        <!-- Главный контент с вкладками -->
        <TabControl Grid.Row="1"
                   Margin="20"
                   Background="White"
                   BorderThickness="0">
            <!-- Вкладка: Ученики -->
            <TabItem Header="👥 Ученики" FontSize="14" Padding="15,10">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Управление студентами -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="➕ Добавить ученика"
                                Style="{StaticResource ModernButton}"
                                Click="AddStudentButton_Click"/>
                        <Button Content="✏️ Редактировать"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource SuccessColor}"
                                Click="EditStudentButton_Click"/>
                        <Button Content="🗑️ Удалить"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource AccentColor}"
                                Click="DeleteStudentButton_Click"/>
                        <Button Content="🔄 Обновить"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource LightTextColor}"
                                Click="RefreshStudentsButton_Click"/>
                    </StackPanel>

                    <!-- Таблица учеников -->
                    <DataGrid x:Name="StudentsDataGrid"
                             Grid.Row="1"
                             Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Класс" Binding="{Binding Class}" Width="100"/>
                            <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDate, StringFormat=dd.MM.yyyy}" Width="150"/>
                            <DataGridTextColumn Header="Телефон родителя" Binding="{Binding ParentPhone}" Width="150"/>
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Информация -->
                    <TextBlock Grid.Row="2"
                              x:Name="StudentsCountTextBlock"
                              FontSize="12"
                              Foreground="{StaticResource LightTextColor}"
                              Margin="0,10,0,0"/>
                </Grid>
            </TabItem>

            <!-- Вкладка: Оценки -->
            <TabItem Header="📊 Оценки" FontSize="14" Padding="15,10">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Управление оценками -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="➕ Добавить оценку"
                                Style="{StaticResource ModernButton}"
                                Click="AddGradeButton_Click"/>
                        <Button Content="🗑️ Удалить оценку"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource AccentColor}"
                                Click="DeleteGradeButton_Click"/>
                        <Button Content="🔄 Обновить"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource LightTextColor}"
                                Click="RefreshGradesButton_Click"/>
                    </StackPanel>

                    <!-- Фильтр -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Фильтр по ученику:"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  FontSize="13"/>
                        <ComboBox x:Name="GradeFilterComboBox"
                                 Width="250"
                                 Style="{StaticResource ModernComboBox}"
                                 SelectionChanged="GradeFilterComboBox_SelectionChanged"
                                 DisplayMemberPath="FullName"/>
                        <Button Content="Сбросить фильтр"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource LightTextColor}"
                                Padding="10,5"
                                Click="ClearGradeFilterButton_Click"/>
                    </StackPanel>

                    <!-- Таблица оценок -->
                    <DataGrid x:Name="GradesDataGrid"
                             Grid.Row="2"
                             Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Ученик" Binding="{Binding StudentName}" Width="*"/>
                            <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="*"/>
                            <DataGridTextColumn Header="Оценка" Binding="{Binding GradeValue}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GradeValue}" Value="5">
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GradeValue}" Value="4">
                                                <Setter Property="Foreground" Value="#3498DB"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GradeValue}" Value="3">
                                                <Setter Property="Foreground" Value="#F39C12"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GradeValue}" Value="2">
                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="120"/>
                            <DataGridTextColumn Header="Тема" Binding="{Binding Topic}" Width="*"/>
                            <DataGridTextColumn Header="Примечание" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка: Посещаемость -->
            <TabItem Header="📅 Посещаемость" FontSize="14" Padding="15,10">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Управление посещаемостью -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="➕ Отметить посещаемость"
                                Style="{StaticResource ModernButton}"
                                Click="AddAttendanceButton_Click"/>
                        <Button Content="🗑️ Удалить запись"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource AccentColor}"
                                Click="DeleteAttendanceButton_Click"/>
                        <Button Content="🔄 Обновить"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource LightTextColor}"
                                Click="RefreshAttendanceButton_Click"/>
                    </StackPanel>

                    <!-- Фильтр -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Фильтр по ученику:"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  FontSize="13"/>
                        <ComboBox x:Name="AttendanceFilterComboBox"
                                 Width="250"
                                 Style="{StaticResource ModernComboBox}"
                                 SelectionChanged="AttendanceFilterComboBox_SelectionChanged"
                                 DisplayMemberPath="FullName"/>
                        <Button Content="Сбросить фильтр"
                                Style="{StaticResource ModernButton}"
                                Background="{StaticResource LightTextColor}"
                                Padding="10,5"
                                Click="ClearAttendanceFilterButton_Click"/>
                    </StackPanel>

                    <!-- Таблица посещаемости -->
                    <DataGrid x:Name="AttendanceDataGrid"
                             Grid.Row="2"
                             Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Ученик" Binding="{Binding StudentName}" Width="*"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="120"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Присутствовал">
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Отсутствовал">
                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="По уважительной причине">
                                                <Setter Property="Foreground" Value="#F39C12"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
