<Window x:Class="ElectronicJournal.Views.AddAttendanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отметить посещаемость"
        Height="450"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundColor}">
    <Border Background="White"
            Margin="20"
            CornerRadius="10"
            Padding="30">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                            Color="#000000"
                            Opacity="0.1"
                            ShadowDepth="0"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Отметить посещаемость"
                      FontSize="20"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextColor}"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"/>

            <TextBlock Text="Ученик"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,0,0,5"/>
            <ComboBox x:Name="StudentComboBox"
                     Style="{StaticResource ModernComboBox}"
                     DisplayMemberPath="FullName"/>

            <TextBlock Text="Дата"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <DatePicker x:Name="DatePicker"
                       FontSize="14"
                       Margin="5"/>

            <TextBlock Text="Статус посещаемости"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <ComboBox x:Name="StatusComboBox"
                     Style="{StaticResource ModernComboBox}"
                     SelectionChanged="StatusComboBox_SelectionChanged">
                <ComboBoxItem Content="Присутствовал" Tag="Присутствовал" IsSelected="True"/>
                <ComboBoxItem Content="Отсутствовал" Tag="Отсутствовал"/>
                <ComboBoxItem Content="По уважительной причине" Tag="По уважительной причине"/>
            </ComboBox>

            <TextBlock Text="Причина отсутствия"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <TextBox x:Name="ReasonTextBox"
                    Style="{StaticResource ModernTextBox}"
                    Height="80"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    VerticalScrollBarVisibility="Auto"/>

            <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0">
                <Button Content="Сохранить"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource SuccessColor}"
                        Click="SaveButton_Click"/>
                <Button Content="Отмена"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource LightTextColor}"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
