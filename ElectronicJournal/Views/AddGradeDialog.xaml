<Window x:Class="ElectronicJournal.Views.AddGradeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АИС Колледж - Добавить оценку"
        Height="600"
        Width="500"
        MinHeight="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundColor}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryColor}"
                Padding="20">
            <TextBlock Text="Добавление оценки"
                      FontSize="20"
                      FontWeight="SemiBold"
                      Foreground="#FFFFFF"
                      HorizontalAlignment="Center"/>
        </Border>

        <!-- Форма -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceColor}"
                Margin="20,15,20,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Padding="25,20">
                <StackPanel>
                    <TextBlock Text="Студент *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="StudentComboBox"
                             Style="{StaticResource ModernComboBox}"
                             DisplayMemberPath="FullName"/>

                    <TextBlock Text="Предмет *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="SubjectComboBox"
                             Style="{StaticResource ModernComboBox}"
                             DisplayMemberPath="Name"/>

                    <TextBlock Text="Оценка *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="GradeComboBox"
                             Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="5 (Отлично)" Tag="5"/>
                        <ComboBoxItem Content="4 (Хорошо)" Tag="4"/>
                        <ComboBoxItem Content="3 (Удовлетворительно)" Tag="3"/>
                        <ComboBoxItem Content="2 (Неудовлетворительно)" Tag="2"/>
                    </ComboBox>

                    <TextBlock Text="Дата *" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="DatePicker"/>

                    <TextBlock Text="Тема занятия" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TopicTextBox" Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Text="Примечание" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NotesTextBox"
                            Style="{StaticResource ModernTextBox}"
                            Height="60"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="* - обязательные поля"
                              FontSize="11"
                              Foreground="{StaticResource LightTextColor}"
                              Margin="0,15,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Кнопки -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceColor}"
                Padding="20,15"
                Margin="20,0,20,15">
            <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource SecondaryButton}"
                        Padding="25,10"
                        Click="CancelButton_Click"/>
                <Button Content="Сохранить"
                        Style="{StaticResource SuccessButton}"
                        Padding="25,10"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
