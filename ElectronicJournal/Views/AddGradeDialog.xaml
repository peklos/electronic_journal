<Window x:Class="ElectronicJournal.Views.AddGradeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить оценку"
        Height="500"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundColor}">
    <Border Background="White"
            Margin="20"
            CornerRadius="10"
            Padding="30">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                            Color="#000000"
                            Opacity="0.1"
                            ShadowDepth="0"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Добавить оценку"
                      FontSize="20"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextColor}"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"/>

            <TextBlock Text="Ученик"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,0,0,5"/>
            <ComboBox x:Name="StudentComboBox"
                     Style="{StaticResource ModernComboBox}"
                     DisplayMemberPath="FullName"/>

            <TextBlock Text="Предмет"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <ComboBox x:Name="SubjectComboBox"
                     Style="{StaticResource ModernComboBox}"
                     DisplayMemberPath="Name"/>

            <TextBlock Text="Оценка"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <ComboBox x:Name="GradeComboBox"
                     Style="{StaticResource ModernComboBox}">
                <ComboBoxItem Content="5 (Отлично)" Tag="5"/>
                <ComboBoxItem Content="4 (Хорошо)" Tag="4"/>
                <ComboBoxItem Content="3 (Удовлетворительно)" Tag="3"/>
                <ComboBoxItem Content="2 (Неудовлетворительно)" Tag="2"/>
            </ComboBox>

            <TextBlock Text="Дата"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <DatePicker x:Name="DatePicker"
                       FontSize="14"
                       Margin="5"/>

            <TextBlock Text="Тема урока"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <TextBox x:Name="TopicTextBox"
                    Style="{StaticResource ModernTextBox}"/>

            <TextBlock Text="Примечание"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <TextBox x:Name="NotesTextBox"
                    Style="{StaticResource ModernTextBox}"
                    Height="60"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    VerticalScrollBarVisibility="Auto"/>

            <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0">
                <Button Content="Сохранить"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource SuccessColor}"
                        Click="SaveButton_Click"/>
                <Button Content="Отмена"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource LightTextColor}"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
