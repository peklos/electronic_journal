<Window x:Class="ElectronicJournal.Views.AddEditStudentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить/Редактировать ученика"
        Height="550"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundColor}">
    <Border Background="{StaticResource SurfaceColor}"
            Margin="20"
            CornerRadius="10"
            Padding="30">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                            Color="#000000"
                            Opacity="0.1"
                            ShadowDepth="0"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="TitleTextBlock"
                      Text="Добавить ученика"
                      FontSize="20"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextColor}"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"/>

            <TextBlock Text="ФИО"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,0,0,5"/>
            <TextBox x:Name="FullNameTextBox"
                    Style="{StaticResource ModernTextBox}"/>

            <TextBlock Text="Класс (например: 9-А)"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <TextBox x:Name="ClassTextBox"
                    Style="{StaticResource ModernTextBox}"/>

            <TextBlock Text="Дата рождения"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <DatePicker x:Name="BirthDatePicker"
                       FontSize="14"
                       Margin="5"/>

            <TextBlock Text="Телефон родителя"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <TextBox x:Name="ParentPhoneTextBox"
                    Style="{StaticResource ModernTextBox}"/>

            <TextBlock Text="Адрес"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <TextBox x:Name="AddressTextBox"
                    Style="{StaticResource ModernTextBox}"/>

            <TextBlock Text="Примечания"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <TextBox x:Name="NotesTextBox"
                    Style="{StaticResource ModernTextBox}"
                    Height="60"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    VerticalScrollBarVisibility="Auto"/>

            <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0">
                <Button Content="Сохранить"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource SuccessColor}"
                        Click="SaveButton_Click"/>
                <Button Content="Отмена"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource LightTextColor}"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
