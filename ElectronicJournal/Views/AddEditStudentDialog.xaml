<Window x:Class="ElectronicJournal.Views.AddEditStudentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить/Редактировать студента"
        Height="850"
        Width="600"
        MinHeight="800"
        MinWidth="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundColor}">
    <Border Background="{StaticResource SurfaceColor}"
            Margin="20"
            CornerRadius="10"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                            Color="#000000"
                            Opacity="0.1"
                            ShadowDepth="0"/>
        </Border.Effect>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">
            <TextBlock x:Name="TitleTextBlock"
                      Text="Добавить студента"
                      FontSize="20"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource TextColor}"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"/>

            <!-- Основная информация -->
            <TextBlock Text="ОСНОВНАЯ ИНФОРМАЦИЯ"
                      FontSize="12"
                      FontWeight="Bold"
                      Foreground="{StaticResource PrimaryColor}"
                      Margin="5,0,0,10"/>

            <TextBlock Text="ФИО *"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,0,0,5"/>
            <TextBox x:Name="FullNameTextBox"
                    Style="{StaticResource ModernTextBox}"/>

            <TextBlock Text="Группа (например: 3ИС1-23) *"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <TextBox x:Name="GroupTextBox"
                    Style="{StaticResource ModernTextBox}"/>

            <TextBlock Text="Дата рождения *"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <DatePicker x:Name="BirthDatePicker"
                       FontSize="14"
                       Margin="5"/>

            <!-- Контактная информация студента -->
            <TextBlock Text="КОНТАКТНАЯ ИНФОРМАЦИЯ СТУДЕНТА"
                      FontSize="12"
                      FontWeight="Bold"
                      Foreground="{StaticResource PrimaryColor}"
                      Margin="5,15,0,10"/>

            <TextBlock Text="Телефон студента"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,0,0,5"/>
            <TextBox x:Name="PhoneTextBox"
                    Style="{StaticResource ModernTextBox}"/>

            <TextBlock Text="Электронная почта"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <TextBox x:Name="EmailTextBox"
                    Style="{StaticResource ModernTextBox}"/>

            <!-- Документы -->
            <TextBlock Text="ДОКУМЕНТЫ"
                      FontSize="12"
                      FontWeight="Bold"
                      Foreground="{StaticResource PrimaryColor}"
                      Margin="5,15,0,10"/>

            <TextBlock Text="Паспортные данные (серия и номер)"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,0,0,5"/>
            <TextBox x:Name="PassportTextBox"
                    Style="{StaticResource ModernTextBox}"/>

            <TextBlock Text="Адрес проживания"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <TextBox x:Name="AddressTextBox"
                    Style="{StaticResource ModernTextBox}"/>

            <!-- Информация о родителях -->
            <TextBlock Text="ИНФОРМАЦИЯ О РОДИТЕЛЯХ"
                      FontSize="12"
                      FontWeight="Bold"
                      Foreground="{StaticResource PrimaryColor}"
                      Margin="5,15,0,10"/>

            <TextBlock Text="ФИО родителей (мать, отец)"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,0,0,5"/>
            <TextBox x:Name="ParentNameTextBox"
                    Style="{StaticResource ModernTextBox}"
                    Height="50"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="Телефон родителей"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <TextBox x:Name="ParentPhoneTextBox"
                    Style="{StaticResource ModernTextBox}"/>

            <TextBlock Text="Место работы родителей"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,10,0,5"/>
            <TextBox x:Name="ParentWorkplaceTextBox"
                    Style="{StaticResource ModernTextBox}"
                    Height="50"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    VerticalScrollBarVisibility="Auto"/>

            <!-- Дополнительно -->
            <TextBlock Text="ДОПОЛНИТЕЛЬНО"
                      FontSize="12"
                      FontWeight="Bold"
                      Foreground="{StaticResource PrimaryColor}"
                      Margin="5,15,0,10"/>

            <TextBlock Text="Примечания"
                      FontSize="13"
                      Foreground="{StaticResource TextColor}"
                      Margin="5,0,0,5"/>
            <TextBox x:Name="NotesTextBox"
                    Style="{StaticResource ModernTextBox}"
                    Height="60"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="* - обязательные поля"
                      FontSize="11"
                      Foreground="{StaticResource LightTextColor}"
                      Margin="5,10,0,0"/>

            <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0">
                <Button Content="Сохранить"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource SuccessColor}"
                        Click="SaveButton_Click"/>
                <Button Content="Отмена"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource LightTextColor}"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
