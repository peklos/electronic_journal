<Window x:Class="ElectronicJournal.Views.AddEditStudentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АИС Колледж - Карточка студента"
        Height="850"
        Width="750"
        MinHeight="800"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundColor}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryColor}"
                Padding="25,18">
            <StackPanel>
                <TextBlock x:Name="TitleTextBlock"
                          Text="Добавление студента"
                          FontSize="22"
                          FontWeight="SemiBold"
                          Foreground="#FFFFFF"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Заполните данные личной карточки"
                          FontSize="13"
                          Foreground="#B0BEC5"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Форма -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceColor}"
                Margin="20,20,20,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.08" ShadowDepth="3"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Padding="30,25">
                <StackPanel>

                    <!-- ЛИЧНЫЕ ДАННЫЕ СТУДЕНТА -->
                    <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ СТУДЕНТА"
                              Style="{StaticResource SectionHeader}"
                              Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
                            <TextBlock Text="Фамилия *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="LastNameTextBox" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="5,0,5,0">
                            <TextBlock Text="Имя *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FirstNameTextBox" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="0" Margin="10,0,0,0">
                            <TextBlock Text="Отчество" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="MiddleNameTextBox" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,10,0">
                            <TextBlock Text="Группа *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="GroupTextBox" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="5,0,5,0">
                            <TextBlock Text="Дата рождения *" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="BirthDatePicker"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="1" Margin="10,0,0,0">
                            <TextBlock Text="Телефон студента" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PhoneTextBox" Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Адрес проживания" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AddressTextBox"
                            Style="{StaticResource ModernTextBox}"
                            Height="50"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            VerticalScrollBarVisibility="Auto"/>

                    <!-- ДАННЫЕ МАТЕРИ -->
                    <TextBlock Text="ДАННЫЕ МАТЕРИ"
                              Style="{StaticResource SectionHeader}"/>

                    <Border Background="#FFF3E0"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,5,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
                                <TextBlock Text="Фамилия" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MotherLastNameTextBox" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="5,0,5,0">
                                <TextBlock Text="Имя" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MotherFirstNameTextBox" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="0" Margin="10,0,0,0">
                                <TextBlock Text="Отчество" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MotherMiddleNameTextBox" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,10,0">
                                <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MotherPhoneTextBox" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Margin="5,0,0,0">
                                <TextBlock Text="Место работы, должность" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MotherWorkplaceTextBox" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ДАННЫЕ ОТЦА -->
                    <TextBlock Text="ДАННЫЕ ОТЦА"
                              Style="{StaticResource SectionHeader}"/>

                    <Border Background="#E3F2FD"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,5,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
                                <TextBlock Text="Фамилия" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="FatherLastNameTextBox" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="5,0,5,0">
                                <TextBlock Text="Имя" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="FatherFirstNameTextBox" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="0" Margin="10,0,0,0">
                                <TextBlock Text="Отчество" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="FatherMiddleNameTextBox" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,10,0">
                                <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="FatherPhoneTextBox" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Margin="5,0,0,0">
                                <TextBlock Text="Место работы, должность" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="FatherWorkplaceTextBox" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ДОПОЛНИТЕЛЬНО -->
                    <TextBlock Text="ДОПОЛНИТЕЛЬНАЯ ИНФОРМАЦИЯ"
                              Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Примечания" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NotesTextBox"
                            Style="{StaticResource ModernTextBox}"
                            Height="70"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="* - обязательные для заполнения поля"
                              FontSize="12"
                              Foreground="{StaticResource LightTextColor}"
                              Margin="0,15,0,0"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Кнопки действий -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceColor}"
                Padding="20,15"
                Margin="20,0,20,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource SecondaryButton}"
                        Padding="30,12"
                        Click="CancelButton_Click"/>
                <Button Content="Сохранить"
                        Style="{StaticResource SuccessButton}"
                        Padding="30,12"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
