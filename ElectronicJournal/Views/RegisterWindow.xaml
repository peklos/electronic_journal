<Window x:Class="ElectronicJournal.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация - Электронный журнал БППК"
        Height="700"
        Width="500"
        MinHeight="650"
        MinWidth="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundColor}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryColor}"
                Padding="20">
            <TextBlock Text="Регистрация в системе"
                      FontSize="24"
                      FontWeight="Bold"
                      Foreground="{StaticResource TextColor}"
                      HorizontalAlignment="Center"/>
        </Border>

        <!-- Форма регистрации -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceColor}"
                Margin="30"
                CornerRadius="10"
                Padding="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                Color="#000000"
                                Opacity="0.5"
                                ShadowDepth="0"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Создание нового аккаунта"
                              FontSize="18"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextColor}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,20"/>

                    <TextBlock Text="Имя пользователя"
                              FontSize="13"
                              Foreground="{StaticResource TextColor}"
                              Margin="5,0,0,5"/>
                    <TextBox x:Name="UsernameTextBox"
                            Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Text="Пароль"
                              FontSize="13"
                              Foreground="{StaticResource TextColor}"
                              Margin="5,10,0,5"/>
                    <PasswordBox x:Name="PasswordBox"
                                Style="{StaticResource ModernPasswordBox}"/>

                    <TextBlock Text="Подтверждение пароля"
                              FontSize="13"
                              Foreground="{StaticResource TextColor}"
                              Margin="5,10,0,5"/>
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                Style="{StaticResource ModernPasswordBox}"/>

                    <TextBlock Text="ФИО"
                              FontSize="13"
                              Foreground="{StaticResource TextColor}"
                              Margin="5,10,0,5"/>
                    <TextBox x:Name="FullNameTextBox"
                            Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Text="Роль"
                              FontSize="13"
                              Foreground="{StaticResource TextColor}"
                              Margin="5,10,0,5"/>
                    <ComboBox x:Name="RoleComboBox"
                             Style="{StaticResource ModernComboBox}"
                             SelectionChanged="RoleComboBox_SelectionChanged">
                        <ComboBoxItem Content="Учитель" IsSelected="True"/>
                        <ComboBoxItem Content="Студент"/>
                    </ComboBox>

                    <!-- Выбор студента для студентов -->
                    <StackPanel x:Name="StudentSelectionPanel"
                               Visibility="Collapsed">
                        <TextBlock Text="Выберите себя из списка студентов"
                                  FontSize="13"
                                  Foreground="{StaticResource TextColor}"
                                  Margin="5,10,0,5"/>
                        <ComboBox x:Name="StudentComboBox"
                                 Style="{StaticResource ModernComboBox}"
                                 DisplayMemberPath="FullName"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorTextBlock"
                              Text=""
                              FontSize="12"
                              Foreground="{StaticResource AccentColor}"
                              HorizontalAlignment="Center"
                              Margin="0,10,0,0"
                              TextWrapping="Wrap"/>

                    <Button Content="Зарегистрироваться"
                            Style="{StaticResource ModernButton}"
                            Margin="0,20,0,0"
                            Click="RegisterButton_Click"/>

                    <Button Content="Отмена"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource LightTextColor}"
                            Margin="0,5,0,0"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
