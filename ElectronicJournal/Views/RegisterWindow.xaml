<Window x:Class="ElectronicJournal.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="АИС Колледж - Регистрация"
        Height="700"
        Width="500"
        MinHeight="650"
        MinWidth="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundColor}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryColor}"
                Padding="20">
            <StackPanel>
                <TextBlock Text="Регистрация в системе"
                          FontSize="22"
                          FontWeight="SemiBold"
                          Foreground="#FFFFFF"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="АИС Колледж"
                          FontSize="13"
                          Foreground="#B0BEC5"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Форма регистрации -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceColor}"
                Margin="25"
                CornerRadius="10"
                Padding="30">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.08" ShadowDepth="3"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Создание учетной записи"
                              FontSize="18"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextColor}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,25"/>

                    <TextBlock Text="Имя пользователя"
                              Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UsernameTextBox"
                            Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Text="Пароль"
                              Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordBox"
                                Style="{StaticResource ModernPasswordBox}"/>

                    <TextBlock Text="Подтверждение пароля"
                              Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                Style="{StaticResource ModernPasswordBox}"/>

                    <TextBlock Text="ФИО"
                              Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FullNameTextBox"
                            Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Text="Роль"
                              Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="RoleComboBox"
                             Style="{StaticResource ModernComboBox}"
                             SelectionChanged="RoleComboBox_SelectionChanged">
                        <ComboBoxItem Content="Преподаватель" IsSelected="True"/>
                        <ComboBoxItem Content="Студент"/>
                    </ComboBox>

                    <!-- Выбор студента для студентов -->
                    <StackPanel x:Name="StudentSelectionPanel"
                               Visibility="Collapsed">
                        <TextBlock Text="Выберите себя из списка студентов"
                                  Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="StudentComboBox"
                                 Style="{StaticResource ModernComboBox}"
                                 DisplayMemberPath="FullName"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorTextBlock"
                              Text=""
                              FontSize="13"
                              Foreground="{StaticResource AccentColor}"
                              HorizontalAlignment="Center"
                              Margin="0,15,0,0"
                              TextWrapping="Wrap"/>

                    <Button Content="Зарегистрироваться"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,25,0,0"
                            Click="RegisterButton_Click"/>

                    <Button Content="Отмена"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,10,0,0"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
